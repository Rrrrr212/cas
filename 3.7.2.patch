index 00000000000..02c454e0c12
--- /dev/null
+++ b/ci/tests/kubernetes/helm/cas-ha-observability/templates/statefulset.yaml
@@ -0,0 +1,101 @@
+apiVersion: apps/v1
+kind: StatefulSet
+metadata:
+  name: {{ include "cas-ha-observability.fullname" . }}
+  labels:
+    {{- include "cas-ha-observability.labels" . | nindent 4 }}
+spec:
+  serviceName: {{ include "cas-ha-observability.fullname" . }}-hazelcast-headless
+  replicas: {{ .Values.replicaCount }}
+  selector:
+    matchLabels:
+      {{- include "cas-ha-observability.selectorLabels" . | nindent 6 }}
+  template:
+    metadata:
+      labels:
+        {{- include "cas-ha-observability.selectorLabels" . | nindent 8 }}
+        {{- with .Values.podLabels }}
+        {{- toYaml . | nindent 8 }}
+        {{- end }}
+      {{- with .Values.podAnnotations }}
+      annotations:
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
+    spec:
+      serviceAccountName: {{ include "cas-ha-observability.serviceAccountName" . }}
+      {{- with .Values.image.pullSecrets }}
+      imagePullSecrets:
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
+      containers:
+        - name: cas
+          image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
+          imagePullPolicy: {{ .Values.image.pullPolicy }}
+          env:
+            - name: SERVER_PORT
+              value: {{ .Values.service.port | quote }}
+            - name: CAS_PROPERTIES
+              value: >-
+                --cas.server.name={{ .Values.cas.serverName }}
+                --cas.server.prefix={{ .Values.cas.serverPrefix }}
+                --cas.monitor.endpoints.endpoint.defaults.access={{ .Values.cas.managementAccess }}
+                --management.endpoints.access.default={{ .Values.cas.endpointAccess }}
+                --management.endpoints.web.exposure.include=health,prometheus,info
+                --management.endpoint.health.show-details=always
+                --management.endpoint.health.probes.enabled=true
+                --management.prometheus.metrics.export.enabled=true
+                --cas.tgc.crypto.signing.key={{ .Values.cas.tgc.signingKey }}
+                --cas.tgc.crypto.encryption.key={{ .Values.cas.tgc.encryptionKey }}
+                --cas.webflow.crypto.signing.key={{ .Values.cas.webflow.signingKey }}
+                --cas.webflow.crypto.encryption.key={{ .Values.cas.webflow.encryptionKey }}
+                {{- if eq .Values.ticketRegistry.type "hazelcast" }}
+                --cas.ticket.registry.hazelcast.cluster.core.instance-name={{ .Values.cas.hazelcast.instanceName }}
+                --cas.ticket.registry.hazelcast.cluster.core.backup-count={{ .Values.cas.hazelcast.backupCount }}
+                --cas.ticket.registry.hazelcast.cluster.core.timeout={{ .Values.cas.hazelcast.timeoutSeconds }}
+                --cas.ticket.registry.hazelcast.cluster.network.port={{ .Values.service.hazelcastPort }}
+                --cas.ticket.registry.hazelcast.cluster.network.port-auto-increment=false
+                --cas.ticket.registry.hazelcast.cluster.network.tcpip-enabled=true
+                --cas.ticket.registry.hazelcast.cluster.network.members={{ include "cas-ha-observability.hazelcastMembers" . }}
+                --cas.ticket.registry.hazelcast.cluster.discovery.multicast.enabled=false
+                --cas.ticket.registry.hazelcast.crypto.enabled={{ .Values.cas.hazelcast.crypto.enabled }}
+                {{- else if eq .Values.ticketRegistry.type "redis" }}
+                --cas.ticket.registry.redis.database={{ .Values.cas.redis.database }}
+                --cas.ticket.registry.redis.username={{ .Values.cas.redis.username }}
+                --cas.ticket.registry.redis.password={{ .Values.cas.redis.password }}
+                --cas.ticket.registry.redis.sentinel.master={{ .Values.cas.redis.sentinel.master }}
+                --cas.ticket.registry.redis.sentinel.password={{ .Values.cas.redis.sentinel.password }}
+                --cas.ticket.registry.redis.sentinel.node={{ join "," .Values.cas.redis.sentinel.nodes }}
+                {{- end }}
+          ports:
+            - name: https
+              containerPort: {{ .Values.service.port }}
+              protocol: TCP
+            - name: hazelcast
+              containerPort: {{ .Values.service.hazelcastPort }}
+              protocol: TCP
+          readinessProbe:
+            httpGet:
+              path: /actuator/health
+              port: https
+              scheme: HTTPS
+            initialDelaySeconds: 60
+            periodSeconds: 20
+            timeoutSeconds: 5
+          livenessProbe:
+            httpGet:
+              path: {{ ternary "/actuator/health/cluster" "/actuator/health" (eq .Values.ticketRegistry.type "hazelcast") }}
+              port: https
+              scheme: HTTPS
+            initialDelaySeconds: 90
+            periodSeconds: 30
+            timeoutSeconds: 5
+          volumeMounts:
+            - name: keystore
+              mountPath: /etc/cas
+              readOnly: true
+          resources:
+            {{- toYaml .Values.resources | nindent 12 }}
+      volumes:
+        - name: keystore
+          secret:
+            secretName: {{ .Values.cas.keystoreSecretName }}
