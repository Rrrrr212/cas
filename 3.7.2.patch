diff --git a/support/cas-server-support-hazelcast-ticket-registry/src/main/java/org/apereo/cas/monitor/HazelcastClusterHealthIndicator.java b/support/cas-server-support-hazelcast-ticket-registry/src/main/java/org/apereo/cas/monitor/HazelcastClusterHealthIndicator.java
