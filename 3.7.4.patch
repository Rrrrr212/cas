+fullnameOverride: ""
+
+serviceAccount:
+  create: true
+  annotations: {}
+  name: "cas-app"
+
+rbac:
+  create: true
+
+podAnnotations:
+  prometheus.io/scrape: "true"
+  prometheus.io/port: "8080"
+  prometheus.io/path: "/cas/actuator/prometheus"
+
+podSecurityContext: {}
+
+securityContext: {}
+
+service:
+  type: ClusterIP
+  ports:
+    http: 8080
+    https: 8443
+    hazelcast: 5701
+
+hazelcast:
+  serviceName: "cas-hazelcast"
+  port: 5701
+  instanceName: "cas-hz"
+
+redis:
