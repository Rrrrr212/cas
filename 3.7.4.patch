diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
new file mode 100644
index 00000000000..9ed336a7581
--- /dev/null
+++ b/.gitlab-ci.yml
@@ -0,0 +1,122 @@
+stages:
+  - build
+  - docker
+  - deploy
+
+variables:
+  GRADLE_OPTS: "-Dorg.gradle.daemon=false -Dorg.gradle.jvmargs=-Xmx4g -Dorg.gradle.parallel=true -Dorg.gradle.caching=true"
+  DOCKER_IMAGE: $CI_REGISTRY_IMAGE/cas
+  DOCKER_TAG: $CI_COMMIT_REF_SLUG-$CI_COMMIT_SHORT_SHA
+  CAS_MODULES: "hazelcast-ticket-registry,redis-ticket-registry,metrics,reports"
+  CAS_WEBAPP: "tomcat"
+
+.gradle_cache: &gradle_cache
+  cache:
+    key: "${CI_COMMIT_REF_SLUG}-gradle"
+    paths:
+      - .gradle/
+      - build/
+    policy: pull-push
+
+before_script:
+  - export GRADLE_USER_HOME=$CI_PROJECT_DIR/.gradle
+
+build-cas:
+  stage: build
+  image: azul/zulu-openjdk:25.0.3
+  <<: *gradle_cache
+  script:
+    - java -version
+    - ./gradlew --version
+    - |
+      ./gradlew clean :webapp:cas-server-webapp-${CAS_WEBAPP}:build \
+        -x test \
+        -x javadoc \
+        -x check \
+        --no-configuration-cache \
+        -DskipNestedConfigMetadataGen=true \
+        -DcasModules=${CAS_MODULES}
+    - |
+      WAR_FILE=$(find webapp/cas-server-webapp-${CAS_WEBAPP}/build/libs -name "cas-server-webapp-${CAS_WEBAPP}-*.war" -not -name "*plain*" | head -1)
+      if [ -f "$WAR_FILE" ]; then
+        cp "$WAR_FILE" webapp/cas-server-webapp-${CAS_WEBAPP}/build/libs/cas.war
+        echo "Copied $WAR_FILE to cas.war"
+      else
+        echo "ERROR: No WAR file found!"
+        exit 1
+      fi
+  artifacts:
+    paths:
+      - webapp/cas-server-webapp-${CAS_WEBAPP}/build/libs/cas.war
+    expire_in: 1h
+  tags:
+    - docker
+  only:
+    - main
+    - develop
+    - /^release\/.*$/
+
+build-docker-image:
+  stage: docker
+  image: docker:27-dind
+  services:
+    - docker:27-dind
+  variables:
+    DOCKER_TLS_CERTDIR: "/certs"
+    DOCKER_HOST: "tcp://docker:2376"
+    DOCKER_DRIVER: overlay2
+  before_script:
+    - docker login -u $CI_REGISTRY_USER -p $CI_REGISTRY_PASSWORD $CI_REGISTRY
+  script:
+    - |
+      docker build \
+        --build-arg JAVA_VERSION=25.0.3 \
+        -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
+        -t ${DOCKER_IMAGE}:latest \
+        -f ci/tests/puppeteer/docker/Dockerfile \
+        .
+    - docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
+    - docker push ${DOCKER_IMAGE}:latest
+  dependencies:
+    - build-cas
+  tags:
+    - docker
+  only:
+    - main
+    - develop
+    - /^release\/.*$/
+
+helm-lint:
+  stage: deploy
+  image: alpine/helm:3.17.2
+  script:
+    - helm lint ci/tests/kubernetes/helm/cas/
+  tags:
+    - docker
+  only:
+    - main
+    - develop
+    - /^release\/.*$/
+
+helm-package:
+  stage: deploy
+  image: alpine/helm:3.17.2
+  script:
+    - |
+      helm package ci/tests/kubernetes/helm/cas/ \
+        --version ${CI_COMMIT_TAG:-$CI_COMMIT_SHORT_SHA} \
+        --app-version ${CI_COMMIT_TAG:-$CI_COMMIT_SHORT_SHA} \
+        --destination charts/
+    - |
+      if [ -n "$CI_COMMIT_TAG" ]; then
+        helm push charts/cas-*.tgz oci://${CI_REGISTRY}/helm
+      fi
+  artifacts:
+    paths:
+      - charts/
+    expire_in: 30d
+  tags:
+    - docker
+  only:
+    - main
+    - /^v\d+\.\d+\.\d+$/
\ No newline at end of file
