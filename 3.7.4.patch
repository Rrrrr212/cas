diff --git a/ci/tests/kubernetes/helm/cas/templates/_helpers.tpl b/ci/tests/kubernetes/helm/cas/templates/_helpers.tpl
new file mode 100644
index 00000000000..8253ce6a415
--- /dev/null
+++ b/ci/tests/kubernetes/helm/cas/templates/_helpers.tpl
@@ -0,0 +1,60 @@
+{{/*
+Expand the name of the chart.
+*/}}
+{{- define "cas.name" -}}
+{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" }}
+{{- end }}
+
+{{/*
+Create a default fully qualified app name.
+*/}}
+{{- define "cas.fullname" -}}
+{{- if .Values.fullnameOverride }}
+{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" }}
+{{- else }}
+{{- $name := default .Chart.Name .Values.nameOverride }}
+{{- if contains $name .Release.Name }}
+{{- .Release.Name | trunc 63 | trimSuffix "-" }}
+{{- else }}
+{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" }}
+{{- end }}
+{{- end }}
+{{- end }}
+
+{{/*
+Create chart name and version as used by the chart label.
+*/}}
+{{- define "cas.chart" -}}
+{{- printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
+{{- end }}
+
+{{/*
+Common labels
+*/}}
+{{- define "cas.labels" -}}
+helm.sh/chart: {{ include "cas.chart" . }}
+{{ include "cas.selectorLabels" . }}
+{{- if .Chart.AppVersion }}
+app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
+{{- end }}
+app.kubernetes.io/managed-by: {{ .Release.Service }}
+{{- end }}
+
+{{/*
+Selector labels
+*/}}
+{{- define "cas.selectorLabels" -}}
+app.kubernetes.io/name: {{ include "cas.name" . }}
+app.kubernetes.io/instance: {{ .Release.Name }}
+{{- end }}
+
+{{/*
+Create the name of the service account to use
+*/}}
+{{- define "cas.serviceAccountName" -}}
+{{- if .Values.serviceAccount.create }}
+{{- default (include "cas.fullname" .) .Values.serviceAccount.name }}
+{{- else }}
+{{- default "default" .Values.serviceAccount.name }}
+{{- end }}
+{{- end }}
\ No newline at end of file
diff --git a/ci/tests/kubernetes/helm/cas/templates/configmap.yaml b/ci/tests/kubernetes/helm/cas/templates/configmap.yaml
new file mode 100644
index 00000000000..d76d5402c9c
--- /dev/null
+++ b/ci/tests/kubernetes/helm/cas/templates/configmap.yaml
@@ -0,0 +1,38 @@
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: {{ include "cas.fullname" . }}-config
+  namespace: {{ .Release.Namespace }}
+  labels:
+    {{- include "cas.labels" . | nindent 4 }}
+data:
+  cas.properties: |
+    cas.server.name={{ .Values.cas.config.server.name }}
+    cas.server.prefix={{ .Values.cas.config.server.prefix }}
+    cas.adminPagesSecurity.ip={{ .Values.cas.config.adminPagesSecurity.ip }}
+    cas.tgc.secure={{ .Values.cas.config.tgc.secure }}
+    cas.tgc.sameSitePolicy={{ .Values.cas.config.tgc.sameSitePolicy }}
+    cas.webflow.session.lock.tgt={{ .Values.cas.config.webflow.session.lock.tgt }}
+
+    cas.ticket.registry.hazelcast.cluster.core.instanceName={{ .Values.cas.config.ticket.registry.hazelcast.cluster.core.instanceName }}
+    cas.ticket.registry.hazelcast.cluster.discovery.enabled={{ .Values.cas.config.ticket.registry.hazelcast.cluster.discovery.enabled }}
+    {{- range .Values.cas.config.ticket.registry.hazelcast.cluster.network.tcpip.members }}
+    cas.ticket.registry.hazelcast.cluster.network.tcpip.members={{ . }}
+    {{- end }}
+
+    {{- if .Values.redis.sentinel.enabled }}
+    cas.ticket.registry.redis.enabled=true
+    cas.ticket.registry.redis.sentinel.master={{ .Values.redis.sentinel.master }}
+    {{- range .Values.redis.sentinel.nodes }}
+    cas.ticket.registry.redis.sentinel.node={{ . }}
+    {{- end }}
+    {{- if .Values.redis.sentinel.password }}
+    cas.ticket.registry.redis.sentinel.password={{ .Values.redis.sentinel.password }}
+    {{- end }}
+    {{- end }}
+
+    management.endpoint.health.show-details=always
+    management.endpoints.web.exposure.include=health,info,prometheus,metrics,env,loggers
+    management.endpoint.health.access=UNRESTRICTED
+    management.health.defaults.enabled=false
+    management.health.hazelcastClusterHealthIndicator.enabled=true
