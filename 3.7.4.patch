diff --git a/ci/tests/kubernetes/helm/cas/templates/redis-sentinel.yaml b/ci/tests/kubernetes/helm/cas/templates/redis-sentinel.yaml
new file mode 100644
index 00000000000..037c5d18bcd
--- /dev/null
+++ b/ci/tests/kubernetes/helm/cas/templates/redis-sentinel.yaml
@@ -0,0 +1,83 @@
+{{- if .Values.redisSentinel.enabled }}
+apiVersion: v1
+kind: Service
+metadata:
+  name: {{ .Values.redisSentinel.serviceName }}
+  namespace: {{ .Release.Namespace }}
+  labels:
+    app: redis-sentinel
+    {{- include "cas.labels" . | nindent 4 }}
+spec:
+  clusterIP: None
+  ports:
+    - port: 26379
+      targetPort: sentinel
+      name: sentinel
+  selector:
+    app: redis-sentinel
+---
+apiVersion: apps/v1
+kind: StatefulSet
+metadata:
+  name: {{ .Values.redisSentinel.serviceName }}
+  namespace: {{ .Release.Namespace }}
+  labels:
+    app: redis-sentinel
+    {{- include "cas.labels" . | nindent 4 }}
+spec:
+  serviceName: {{ .Values.redisSentinel.serviceName }}
+  replicas: {{ .Values.redisSentinel.replicas }}
+  selector:
+    matchLabels:
+      app: redis-sentinel
+  template:
+    metadata:
+      labels:
+        app: redis-sentinel
+    spec:
+      containers:
+        - name: redis-sentinel
+          image: "{{ .Values.redisSentinel.image.repository }}:{{ .Values.redisSentinel.image.tag }}"
+          ports:
+            - name: sentinel
+              containerPort: 26379
+              protocol: TCP
+          env:
+            - name: REDIS_MASTER_SET
+              value: {{ .Values.redisSentinel.masterSet | quote }}
+            - name: REDIS_MASTER_HOST
+              value: {{ .Values.redisSentinel.masterHost | quote }}
+            - name: REDIS_MASTER_PORT_NUMBER
+              value: {{ .Values.redisSentinel.masterPort | quote }}
+            - name: REDIS_SENTINEL_QUORUM
+              value: {{ .Values.redisSentinel.quorum | quote }}
+          command:
+            - redis-server
+          args:
+            - /usr/local/etc/redis/sentinel.conf
+            - --sentinel
+          volumeMounts:
+            - name: sentinel-config
+              mountPath: /usr/local/etc/redis
+      volumes:
+        - name: sentinel-config
+          configMap:
+            name: {{ include "cas.fullname" . }}-redis-sentinel-config
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: {{ include "cas.fullname" . }}-redis-sentinel-config
+  namespace: {{ .Release.Namespace }}
+  labels:
+    {{- include "cas.labels" . | nindent 4 }}
+data:
+  sentinel.conf: |
+    port 26379
+    dir /tmp
+    sentinel resolve-hostnames yes
+    sentinel monitor {{ .Values.redisSentinel.masterSet }} {{ .Values.redisSentinel.masterHost }} {{ .Values.redisSentinel.masterPort }} {{ .Values.redisSentinel.quorum }}
+    sentinel down-after-milliseconds {{ .Values.redisSentinel.masterSet }} 5000
+    sentinel failover-timeout {{ .Values.redisSentinel.masterSet }} 10000
+    sentinel parallel-syncs {{ .Values.redisSentinel.masterSet }} 1
+{{- end }}
\ No newline at end of file
