diff --git a/ci/tests/kubernetes/prometheus-alerts.yaml b/ci/tests/kubernetes/prometheus-alerts.yaml
new file mode 100644
index 00000000000..7bac7a63eb8
--- /dev/null
+++ b/ci/tests/kubernetes/prometheus-alerts.yaml
@@ -0,0 +1,67 @@
+groups:
+  - name: cas-hazelcast-alerts
+    rules:
+      - alert: HazelcastClusterDegraded
+        expr: hazelcast_cluster_members < 2
+        for: 1m
+        labels:
+          severity: critical
+          component: cas
+          feature: hazelcast-ticket-registry
+        annotations:
+          summary: "Hazelcast cluster has fewer than 2 members"
+          description: "CAS Hazelcast cluster '{{ $labels.instance }}' has only {{ $value }} member(s). High availability is at risk. Ticket replication may be compromised."
