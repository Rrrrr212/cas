diff --git a/ci/tests/kubernetes/helm/cas/templates/rbac.yaml b/ci/tests/kubernetes/helm/cas/templates/rbac.yaml
new file mode 100644
index 00000000000..98d82806209
--- /dev/null
+++ b/ci/tests/kubernetes/helm/cas/templates/rbac.yaml
@@ -0,0 +1,32 @@
+{{- if .Values.rbac.create }}
+apiVersion: rbac.authorization.k8s.io/v1
+kind: Role
+metadata:
+  name: {{ include "cas.fullname" . }}-discovery
+  namespace: {{ .Release.Namespace }}
+  labels:
+    {{- include "cas.labels" . | nindent 4 }}
+rules:
+  - apiGroups: [""]
+    resources: ["endpoints", "services", "pods", "configmaps", "secrets"]
+    verbs: ["get", "list", "watch", "create", "update", "patch"]
+  - apiGroups: ["discovery.k8s.io"]
+    resources: ["endpointslices"]
+    verbs: ["get", "list", "watch", "create", "update", "patch"]
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: RoleBinding
+metadata:
+  name: {{ include "cas.fullname" . }}-discovery
+  namespace: {{ .Release.Namespace }}
+  labels:
+    {{- include "cas.labels" . | nindent 4 }}
+subjects:
+  - kind: ServiceAccount
+    name: {{ include "cas.serviceAccountName" . }}
+    namespace: {{ .Release.Namespace }}
+roleRef:
+  kind: Role
+  name: {{ include "cas.fullname" . }}-discovery
+  apiGroup: rbac.authorization.k8s.io
+{{- end }}
