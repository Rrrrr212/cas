+    enabled: true
+    master: "mymaster"
+    nodes:
+      - "redis-sentinel-0.redis-sentinel:26379"
+      - "redis-sentinel-1.redis-sentinel:26379"
+      - "redis-sentinel-2.redis-sentinel:26379"
+    password: ""
+
+ingress:
+  enabled: false
+  className: ""
+  annotations: {}
+  hosts:
