diff --git a/helm/cas/templates/statefulset.yaml b/helm/cas/templates/statefulset.yaml
new file mode 100644
index 00000000000..a7dfb80de1b
--- /dev/null
+++ b/helm/cas/templates/statefulset.yaml
@@ -0,0 +1,58 @@
+apiVersion: apps/v1
+kind: StatefulSet
+metadata:
+  name: {{ include "cas.fullname" . }}
+  labels:
+    app: {{ include "cas.fullname" . }}
+spec:
+  serviceName: {{ include "cas.fullname" . }}
+  replicas: {{ .Values.replicaCount }}
+  selector:
+    matchLabels:
+      app: {{ include "cas.fullname" . }}
+  template:
+    metadata:
+      labels:
+        app: {{ include "cas.fullname" . }}
+    spec:
+      containers:
+        - name: cas
+          image: "{{ .Values.image.repository }}:{{ .Values.image.tag | default .Chart.AppVersion }}"
+          imagePullPolicy: {{ .Values.image.pullPolicy }}
+          ports:
+            - name: http
+              containerPort: 8080
+              protocol: TCP
+            - name: hazelcast
+              containerPort: 5701
+              protocol: TCP
+          env:
+            # Hazelcast TCP Discovery
+            - name: CAS_TICKET_REGISTRY_HAZELCAST_CLUSTER_NETWORK_TCPIP_ENABLED
+              value: "true"
+            - name: CAS_TICKET_REGISTRY_HAZELCAST_CLUSTER_NETWORK_TCPIP_MEMBERS
+              value: {{ .Values.hazelcast.members | quote }}
+            - name: CAS_TICKET_REGISTRY_HAZELCAST_CLUSTER_MULTICAST_ENABLED
+              value: "false"
+            
+            # Redis Sentinel Configuration
+            - name: CAS_TICKET_REGISTRY_REDIS_SENTINEL_MASTER
+              value: {{ .Values.redis.sentinel.master | quote }}
+            - name: CAS_TICKET_REGISTRY_REDIS_SENTINEL_NODE_0
+              value: {{ index (splitList "," .Values.redis.sentinel.nodes) 0 | quote }}
+            - name: CAS_TICKET_REGISTRY_REDIS_SENTINEL_NODE_1
+              value: {{ index (splitList "," .Values.redis.sentinel.nodes) 1 | quote }}
+            - name: CAS_TICKET_REGISTRY_REDIS_SENTINEL_NODE_2
+              value: {{ index (splitList "," .Values.redis.sentinel.nodes) 2 | quote }}
+          livenessProbe:
+            httpGet:
+              path: /cas/actuator/health/cluster
+              port: http
+            initialDelaySeconds: 60
+            periodSeconds: 10
+          readinessProbe:
+            httpGet:
+              path: /cas/actuator/health
+              port: http
+            initialDelaySeconds: 60
+            periodSeconds: 10
diff --git a/helm/cas/values.yaml b/helm/cas/values.yaml
new file mode 100644
index 00000000000..d2b48536d5d
--- /dev/null
+++ b/helm/cas/values.yaml
@@ -0,0 +1,18 @@
+replicaCount: 3
+
+image:
+  repository: apereo/cas
+  pullPolicy: IfNotPresent
+  tag: "latest"
+
+hazelcast:
+  members: "cas-0.cas.default.svc.cluster.local,cas-1.cas.default.svc.cluster.local,cas-2.cas.default.svc.cluster.local"
+
+redis:
+  sentinel:
+    master: "mymaster"
+    nodes: "redis-sentinel-0.redis-sentinel.default.svc.cluster.local:26379,redis-sentinel-1.redis-sentinel.default.svc.cluster.local:26379,redis-sentinel-2.redis-sentinel.default.svc.cluster.local:26379"
+
+service:
+  type: ClusterIP
+  port: 8080
diff --git a/prometheus/alerts/hazelcast.yml b/prometheus/alerts/hazelcast.yml
new file mode 100644
index 00000000000..b5dd28d9b24
--- /dev/null
+++ b/prometheus/alerts/hazelcast.yml
@@ -0,0 +1,11 @@
+groups:
+  - name: cas.alerts
+    rules:
+      - alert: HazelcastClusterSplitBrain
+        expr: hazelcast_cluster_members < 2
+        for: 1m
+        labels:
+          severity: critical
+        annotations:
+          summary: "Hazelcast Cluster Split Brain or Member Loss"
+          description: "The Hazelcast cluster members count has dropped below 2. Current value is {{ $value }}."
diff --git a/support/cas-server-support-hazelcast-ticket-registry/src/main/java/org/apereo/cas/config/CasHazelcastTicketRegistryAutoConfiguration.java b/support/cas-server-support-hazelcast-ticket-registry/src/main/java/org/apereo/cas/config/CasHazelcastTicketRegistryAutoConfiguration.java
index 1f62a9ef259..351611e53c6 100644
--- a/support/cas-server-support-hazelcast-ticket-registry/src/main/java/org/apereo/cas/config/CasHazelcastTicketRegistryAutoConfiguration.java
+++ b/support/cas-server-support-hazelcast-ticket-registry/src/main/java/org/apereo/cas/config/CasHazelcastTicketRegistryAutoConfiguration.java
@@ -26,6 +26,8 @@ import com.hazelcast.instance.impl.HazelcastInstanceFactory;
 import lombok.extern.slf4j.Slf4j;
 import lombok.val;
 import org.springframework.beans.factory.annotation.Qualifier;
+import org.springframework.boot.actuate.health.Health;
+import org.springframework.boot.actuate.health.HealthIndicator;
 import org.springframework.boot.autoconfigure.AutoConfiguration;
 import org.springframework.boot.autoconfigure.condition.ConditionalOnMissingBean;
 import org.springframework.boot.context.properties.EnableConfigurationProperties;
@@ -146,4 +148,23 @@ public class CasHazelcastTicketRegistryAutoConfiguration {
     public TicketRegistryCleaner ticketRegistryCleaner() {
         return NoOpTicketRegistryCleaner.getInstance();
     }
+
+    @Bean
+    @ConditionalOnMissingBean(name = "clusterHealthIndicator")
+    public HealthIndicator clusterHealthIndicator(
+        @Qualifier("casTicketRegistryHazelcastInstance") final HazelcastInstance casTicketRegistryHazelcastInstance) {
+        return () -> {
+            try {
+                val cluster = casTicketRegistryHazelcastInstance.getCluster();
+                val members = cluster.getMembers();
+                val builder = Health.up()
+                    .withDetail("clusterState", cluster.getClusterState().name())
+                    .withDetail("clusterTime", cluster.getClusterTime())
+                    .withDetail("members", members.size());
+                return builder.build();
+            } catch (final Exception e) {
+                return Health.down(e).build();
+            }
+        };
+    }
 }
