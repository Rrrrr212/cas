@@ -0,0 +1,58 @@
+package org.apereo.cas.support.saml.idp.authenticator;
+
+import module java.base;
+import org.apereo.cas.pac4j.authenticator.TokenValidationStrategy;
+import org.apereo.cas.ticket.ServiceTicket;
+import org.apereo.cas.ticket.artifact.SamlArtifactTicket;
+import org.apereo.cas.ticket.query.SamlAttributeQueryTicket;
+import org.apereo.cas.ticket.registry.TicketRegistry;
+import org.apereo.cas.util.function.FunctionUtils;
+import lombok.RequiredArgsConstructor;
+import lombok.val;
+import org.pac4j.core.context.CallContext;
+import org.pac4j.core.credentials.TokenCredentials;
+
+@RequiredArgsConstructor
+public class SamlTokenValidationStrategy implements TokenValidationStrategy<ServiceTicket> {
+    private final TicketRegistry ticketRegistry;
+
+    @Override
+    public String resolveToken(final TokenCredentials tokenCredentials, final CallContext callContext) {
+        return tokenCredentials.getToken();
+    }
+
+    @Override
+    public Optional<ServiceTicket> resolveTicket(final String token,
+                                                 final TokenCredentials tokenCredentials,
+                                                 final CallContext callContext) {
+        val attributeQueryTicket = FunctionUtils.doAndHandle(() -> ticketRegistry.getTicket(token, SamlAttributeQueryTicket.class));
+        if (attributeQueryTicket != null) {
+            return Optional.of(attributeQueryTicket);
+        }
+
+        val artifactTicket = FunctionUtils.doAndHandle(() -> ticketRegistry.getTicket(token, SamlArtifactTicket.class));
+        return Optional.ofNullable(artifactTicket);
+    }
+
+    @Override
+    public Map<String, Object> buildTicketAttributes(final ServiceTicket ticket,
+                                                     final TokenCredentials tokenCredentials,
+                                                     final CallContext callContext) {
+        val attributes = new HashMap<String, Object>();
+        attributes.put("ticketId", ticket.getId());
+
+        if (ticket.getService() != null) {
+            attributes.put("service", ticket.getService().getId());
+        }
+
+        if (ticket instanceof SamlAttributeQueryTicket samlAttributeQueryTicket) {
+            attributes.put("samlRelyingParty", samlAttributeQueryTicket.getRelyingParty());
+            attributes.put("samlObject", samlAttributeQueryTicket.getObject());
+        }
+
+        if (ticket instanceof SamlArtifactTicket samlArtifactTicket) {
+            attributes.put("samlRelyingParty", samlArtifactTicket.getRelyingPartyId());
+            attributes.put("samlIssuer", samlArtifactTicket.getIssuer());
+            attributes.put("samlObject", samlArtifactTicket.getObject());
+        }
+        return attributes;
+    }
+}
