@@ -0,0 +1,58 @@
+package org.apereo.cas.support.oauth.authenticator;
+
+import module java.base;
+import org.apereo.cas.pac4j.authenticator.TokenValidationStrategy;
+import org.apereo.cas.support.oauth.OAuth20Constants;
+import org.apereo.cas.support.oauth.web.response.accesstoken.response.OAuth20JwtAccessTokenEncoder;
+import org.apereo.cas.ticket.accesstoken.OAuth20AccessToken;
+import org.apereo.cas.ticket.registry.TicketRegistry;
+import org.apereo.cas.token.JwtBuilder;
+import org.apereo.cas.util.function.FunctionUtils;
+import lombok.Getter;
+import lombok.RequiredArgsConstructor;
+import lombok.Setter;
+import lombok.extern.slf4j.Slf4j;
+import lombok.val;
+import org.pac4j.core.context.CallContext;
+import org.pac4j.core.credentials.TokenCredentials;
+
+@Slf4j
+@RequiredArgsConstructor
+@Getter
+@Setter
+public class OAuth2TokenValidationStrategy implements TokenValidationStrategy<OAuth20AccessToken> {
+    private final TicketRegistry ticketRegistry;
+
+    private final JwtBuilder accessTokenJwtBuilder;
+
+    private Set<String> requiredScopes = new LinkedHashSet<>();
+
+    @Override
+    public String resolveToken(final TokenCredentials tokenCredentials, final CallContext callContext) {
+        return OAuth20JwtAccessTokenEncoder.toDecodableCipher(accessTokenJwtBuilder).decode(tokenCredentials.getToken());
+    }
+
+    @Override
+    public Optional<OAuth20AccessToken> resolveTicket(final String token,
+                                                      final TokenCredentials tokenCredentials,
+                                                      final CallContext callContext) {
+        return Optional.ofNullable(FunctionUtils.doAndHandle(() -> ticketRegistry.getTicket(token, OAuth20AccessToken.class)));
+    }
+
+    @Override
+    public boolean supports(final OAuth20AccessToken ticket,
+                            final TokenCredentials tokenCredentials,
+                            final CallContext callContext) {
+        if (requiredScopes.isEmpty() || ticket.getScopes().containsAll(requiredScopes)) {
+            return true;
+        }
+
+        LOGGER.error("Unable to authenticate access token without required scopes [{}]", requiredScopes);
+        return false;
+    }
+
+    @Override
+    public Map<String, Object> buildTicketAttributes(final OAuth20AccessToken ticket,
+                                                     final TokenCredentials tokenCredentials,
+                                                     final CallContext callContext) {
+        val attributes = new HashMap<String, Object>();
+        attributes.put(OAuth20Constants.CLIENT_ID, ticket.getClientId());
+        return attributes;
+    }
+}
