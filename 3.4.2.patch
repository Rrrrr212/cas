+package org.apereo.cas.pac4j.authenticator;
+
+import module java.base;
+import org.apereo.cas.ticket.AuthenticationAwareTicket;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import lombok.val;
+import org.pac4j.core.context.CallContext;
+import org.pac4j.core.credentials.Credentials;
+import org.pac4j.core.credentials.TokenCredentials;
+import org.pac4j.core.credentials.authenticator.Authenticator;
+import org.pac4j.core.profile.CommonProfile;
+
+@Slf4j
+@RequiredArgsConstructor
+public abstract class AbstractTokenAuthenticator<T extends AuthenticationAwareTicket> implements Authenticator {
+    private final TokenValidationStrategy<T> tokenValidationStrategy;
+
+    @Override
+    public Optional<Credentials> validate(final CallContext callContext, final Credentials credentials) {
+        val tokenCredentials = (TokenCredentials) credentials;
+        val token = tokenValidationStrategy.resolveToken(tokenCredentials, callContext);
+        LOGGER.trace("Received token [{}] for authentication", token);
+
+        val ticket = tokenValidationStrategy.resolveTicket(token, tokenCredentials, callContext).orElse(null);
+        if (ticket == null || ticket.isExpired()) {
+            LOGGER.error("Provided token [{}] is either not found in the ticket registry or has expired", token);
+            return Optional.empty();
+        }
+
+        if (!tokenValidationStrategy.supports(ticket, tokenCredentials, callContext)) {
+            return Optional.empty();
+        }
+
+        val profile = buildUserProfile(ticket, tokenCredentials, callContext);
+        tokenCredentials.setUserProfile(profile);
+        LOGGER.trace("Final user profile based on token [{}] is [{}]", ticket, profile);
+        return Optional.of(tokenCredentials);
+    }
+
+    protected CommonProfile buildUserProfile(final T ticket,
+                                             final TokenCredentials tokenCredentials,
+                                             final CallContext callContext) {
+        val userProfile = new CommonProfile(true);
+        val authentication = ticket.getAuthentication();
+        val principal = authentication.getPrincipal();
+
+        userProfile.setId(principal.getId());
+
+        val attributes = new HashMap<String, Object>(principal.getAttributes());
+        attributes.putAll(authentication.getAttributes());
+        attributes.putAll(tokenValidationStrategy.buildTicketAttributes(ticket, tokenCredentials, callContext));
+
+        userProfile.addAttributes(attributes);
+        LOGGER.trace("Built user profile based on token [{}] is [{}]", ticket, userProfile);
+        return userProfile;
+    }
+
+    protected TokenValidationStrategy<T> getTokenValidationStrategy() {
+        return tokenValidationStrategy;
+    }
+}
