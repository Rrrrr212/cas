+package org.apereo.cas.configuration.model.support.token;
+
+import module java.base;
+import org.apereo.cas.configuration.features.CasFeatureModule;
+import org.apereo.cas.configuration.model.support.ldap.LdapAuthenticationProperties;
+import org.apereo.cas.configuration.model.support.mongo.MongoDbAuthenticationProperties;
+import org.apereo.cas.configuration.support.RequiresModule;
+import lombok.Getter;
+import lombok.Setter;
+import lombok.experimental.Accessors;
+import org.springframework.boot.context.properties.NestedConfigurationProperty;
+
+@Getter
+@Setter
+@Accessors(chain = true)
+@RequiresModule(name = "cas-server-support-token-webflow")
+public class TokenAuthProperties implements Serializable, CasFeatureModule {
+    @Serial
+    private static final long serialVersionUID = -5661982471502401165L;
+
+    private boolean enabled = true;
+
+    private RepositoryType repositoryType = RepositoryType.LDAP;
+
+    private Map<String, String> attributeMapping = new LinkedHashMap<>();
+
+    @NestedConfigurationProperty
+    private LdapAuthenticationProperties ldap = new LdapAuthenticationProperties();
+
+    @NestedConfigurationProperty
+    private MongoDbAuthenticationProperties mongo = new MongoDbAuthenticationProperties();
+
+    public enum RepositoryType {
+        LDAP,
+        MONGO
+    }
+}
