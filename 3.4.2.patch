@@ -0,0 +1,22 @@
+package org.apereo.cas.pac4j.authenticator;
+
+import module java.base;
+import org.apereo.cas.ticket.AuthenticationAwareTicket;
+import org.pac4j.core.context.CallContext;
+import org.pac4j.core.credentials.TokenCredentials;
+
+public interface TokenValidationStrategy<T extends AuthenticationAwareTicket> {
+    String resolveToken(TokenCredentials tokenCredentials, CallContext callContext);
+
+    Optional<T> resolveTicket(String token, TokenCredentials tokenCredentials, CallContext callContext);
+
+    default boolean supports(final T ticket, final TokenCredentials tokenCredentials, final CallContext callContext) {
+        return true;
+    }
+
+    default Map<String, Object> buildTicketAttributes(final T ticket,
+                                                      final TokenCredentials tokenCredentials,
+                                                      final CallContext callContext) {
+        return Map.of();
+    }
+}
