diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
new file mode 100644
index 00000000000..cc0f92b617d
--- /dev/null
+++ b/.gitlab-ci.yml
@@ -0,0 +1,140 @@
+stages:
+  - build
+  - package
+  - publish
+  - deploy
+
+variables:
+  GRADLE_OPTS: "-Dorg.gradle.daemon=false -Dorg.gradle.parallel=true -Dorg.gradle.caching=true"
+  DOCKER_IMAGE: $CI_REGISTRY_IMAGE/cas
+  HELM_CHART: $CI_REGISTRY_IMAGE/charts/cas
+
+.gradle-cache: &gradle-cache
+  cache:
+    key: "${CI_COMMIT_REF_SLUG}-gradle"
+    paths:
+      - .gradle/
+      - build/
+    policy: pull-push
+
+build:cas:
+  stage: build
+  image: eclipse-temurin:25-jdk
+  <<: *gradle-cache
+  script:
+    - ./gradlew build --parallel -x test -x javadoc -x check
+    - ./gradlew :webapp:cas-server-webapp-tomcat:bootWar
+  artifacts:
+    paths:
+      - webapp/cas-server-webapp-tomcat/build/libs/cas.war
+    expire_in: 1 day
+  rules:
+    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
+    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
+
+test:cas:
+  stage: build
+  image: eclipse-temurin:25-jdk
+  <<: *gradle-cache
+  script:
+    - ./gradlew :support:cas-server-support-hazelcast-ticket-registry:test
+  rules:
+    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
+    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
+
+package:docker:
+  stage: package
+  image: docker:27
+  services:
+    - docker:27-dind
+  dependencies:
+    - build:cas
+  variables:
+    DOCKER_TLS_CERTDIR: "/certs"
+  before_script:
+    - echo "$CI_REGISTRY_PASSWORD" | docker login -u "$CI_REGISTRY_USER" --password-stdin $CI_REGISTRY
+  script:
+    - |
+      docker build \
+        --build-arg JAVA_VERSION=25.0.3 \
+        --build-arg CAS_WAR=webapp/cas-server-webapp-tomcat/build/libs/cas.war \
+        -t $DOCKER_IMAGE:$CI_COMMIT_SHORT_SHA \
+        -t $DOCKER_IMAGE:$CI_COMMIT_REF_SLUG \
+        -f ci/docker/Dockerfile \
+        .
+    - docker push $DOCKER_IMAGE:$CI_COMMIT_SHORT_SHA
+    - docker push $DOCKER_IMAGE:$CI_COMMIT_REF_SLUG
+  rules:
+    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
+
+package:helm:
+  stage: package
+  image: alpine/helm:3.16
+  script:
+    - helm package helm/cas --version ${CI_COMMIT_TAG:-1.0.0-rc.${CI_COMMIT_SHORT_SHA}} --app-version ${CI_COMMIT_TAG:-latest}
+    - helm registry login -u "$CI_REGISTRY_USER" -p "$CI_REGISTRY_PASSWORD" $CI_REGISTRY
+    - helm push cas-*.tgz oci://$CI_REGISTRY_IMAGE/charts
+  rules:
+    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
+
+publish:tag:
+  stage: publish
+  image: docker:27
+  services:
+    - docker:27-dind
+  variables:
+    DOCKER_TLS_CERTDIR: "/certs"
+  before_script:
+    - echo "$CI_REGISTRY_PASSWORD" | docker login -u "$CI_REGISTRY_USER" --password-stdin $CI_REGISTRY
+  script:
+    - docker pull $DOCKER_IMAGE:$CI_COMMIT_SHORT_SHA
+    - docker tag $DOCKER_IMAGE:$CI_COMMIT_SHORT_SHA $DOCKER_IMAGE:$CI_COMMIT_TAG
+    - docker tag $DOCKER_IMAGE:$CI_COMMIT_SHORT_SHA $DOCKER_IMAGE:latest
+    - docker push $DOCKER_IMAGE:$CI_COMMIT_TAG
+    - docker push $DOCKER_IMAGE:latest
+  rules:
+    - if: $CI_COMMIT_TAG
+
+deploy:staging:
+  stage: deploy
+  image: alpine/k8s:1.31
+  script:
+    - kubectl config use-context staging
+    - |
+      helm upgrade --install cas oci://$CI_REGISTRY_IMAGE/charts/cas \
+        --version ${CI_COMMIT_TAG:-1.0.0-rc.${CI_COMMIT_SHORT_SHA}} \
+        --namespace cas-staging \
+        --create-namespace \
+        --set image.repository=$DOCKER_IMAGE \
+        --set image.tag=$CI_COMMIT_SHORT_SHA \
+        --set hazelcast.members="cas-0.cas.cas-staging.svc.cluster.local,cas-1.cas.cas-staging.svc.cluster.local,cas-2.cas.cas-staging.svc.cluster.local" \
+        --set redis.sentinel.hosts="redis-sentinel.cas-staging.svc.cluster.local:26379" \
+        --values helm/cas/values.yaml
+  environment:
+    name: staging
+    url: https://cas-staging.example.com/cas
+  rules:
+    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
+
+deploy:production:
+  stage: deploy
+  image: alpine/k8s:1.31
+  script:
+    - kubectl config use-context production
+    - |
+      helm upgrade --install cas oci://$CI_REGISTRY_IMAGE/charts/cas \
+        --version $CI_COMMIT_TAG \
+        --namespace cas-production \
+        --create-namespace \
+        --set image.repository=$DOCKER_IMAGE \
+        --set image.tag=$CI_COMMIT_TAG \
+        --set replicaCount=5 \
+        --set hazelcast.members="cas-0.cas.cas-production.svc.cluster.local,cas-1.cas.cas-production.svc.cluster.local,cas-2.cas.cas-production.svc.cluster.local,cas-3.cas.cas-production.svc.cluster.local,cas-4.cas.cas-production.svc.cluster.local" \
+        --set redis.sentinel.hosts="redis-sentinel.cas-production.svc.cluster.local:26379" \
+        --values helm/cas/values.yaml
+  environment:
+    name: production
+    url: https://cas.example.com/cas
+  rules:
+    - if: $CI_COMMIT_TAG
+      when: manual
diff --git a/ci/docker/Dockerfile b/ci/docker/Dockerfile
new file mode 100644
index 00000000000..2477abfcb06
--- /dev/null
+++ b/ci/docker/Dockerfile
@@ -0,0 +1,23 @@
+ARG JAVA_VERSION=25.0.3
+FROM azul/zulu-openjdk:${JAVA_VERSION}
+
+ARG CAS_WAR
+
+ENV RUN_ARGS=""
+ENV CAS_PROPERTIES=""
+ENV SERVER_PORT="8443"
+
+RUN cd / \
+    && mkdir -p /etc/cas/config \
+    && mkdir -p /etc/cas/services \
+    && mkdir -p cas-server
+
+COPY ${CAS_WAR} cas-server/cas.war
+COPY ci/docker/entrypoint.sh cas-server/
+RUN chmod +x /cas-server/entrypoint.sh
+
+EXPOSE 8080 $SERVER_PORT 5701
+
+ENV PATH=$PATH:$JAVA_HOME/bin:.
+WORKDIR cas-server
+ENTRYPOINT ["/cas-server/entrypoint.sh"]
diff --git a/ci/docker/entrypoint.sh b/ci/docker/entrypoint.sh
new file mode 100644
index 00000000000..87f55e54a5a
--- /dev/null
+++ b/ci/docker/entrypoint.sh
@@ -0,0 +1,17 @@
+#!/bin/bash
+
+java -version
+echo "================================"
+echo -e "JVM runtime arguments:\n${RUN_ARGS}"
+echo "================================"
+echo -e "CAS properties:\n${CAS_PROPERTIES}"
+echo "================================"
+echo "Launching CAS server in Docker container..."
+echo "================================"
+exec java ${RUN_ARGS} \
+  -Dlog.console.stacktraces=true \
+  -jar cas.war \
+  --server.port=${SERVER_PORT} \
+  --spring.profiles.active=none \
+  --cas.audit.slf4j.use-single-line=true \
+  ${CAS_PROPERTIES}
