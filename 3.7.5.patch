diff --git a/helm/cas/templates/_helpers.tpl b/helm/cas/templates/_helpers.tpl
new file mode 100644
index 00000000000..c6563107684
--- /dev/null
+++ b/helm/cas/templates/_helpers.tpl
@@ -0,0 +1,30 @@
+{{- define "cas.name" -}}
+{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" }}
+{{- end }}
+
+{{- define "cas.fullname" -}}
+{{- if .Values.fullnameOverride }}
+{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" }}
+{{- else }}
+{{- $name := default .Chart.Name .Values.nameOverride }}
+{{- if contains $name .Release.Name }}
+{{- .Release.Name | trunc 63 | trimSuffix "-" }}
+{{- else }}
+{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" }}
+{{- end }}
+{{- end }}
+{{- end }}
+
+{{- define "cas.labels" -}}
+helm.sh/chart: {{ printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
+{{ include "cas.selectorLabels" . }}
+{{- if .Chart.AppVersion }}
+app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
+{{- end }}
+app.kubernetes.io/managed-by: {{ .Release.Service }}
+{{- end }}
+
+{{- define "cas.selectorLabels" -}}
+app.kubernetes.io/name: {{ include "cas.name" . }}
+app.kubernetes.io/instance: {{ .Release.Name }}
+{{- end }}
diff --git a/helm/cas/templates/configmap.yaml b/helm/cas/templates/configmap.yaml
new file mode 100644
index 00000000000..c34077ff43e
--- /dev/null
+++ b/helm/cas/templates/configmap.yaml
@@ -0,0 +1,90 @@
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: {{ include "cas.fullname" . }}-config
+  labels:
+    {{- include "cas.labels" . | nindent 4 }}
+data:
+  CAS_PROPERTIES: |
+    {
+      "cas": {
+        "ticket": {
+          "registry": {
+            {{- if .Values.hazelcast.enabled }}
+            "hazelcast": {
+              "cluster": {
+                "core": {
+                  "instance-name": "{{ .Values.hazelcast.cluster.instanceName }}",
+                  "backup-count": {{ .Values.hazelcast.cluster.backupCount }},
+                  "async-backup-count": {{ .Values.hazelcast.cluster.asyncBackupCount }},
+                  "eviction-policy": "{{ .Values.hazelcast.cluster.evictionPolicy }}",
+                  "max-size-policy": "{{ .Values.hazelcast.cluster.maxSizePolicy }}",
+                  "max-size": {{ .Values.hazelcast.cluster.maxSize }},
+                  "enable-jet": {{ .Values.hazelcast.cluster.enableJet }}
+                },
+                "network": {
+                  "tcpip-enabled": {{ .Values.hazelcast.tcpIpEnabled }},
+                  "port": {{ .Values.hazelcast.port }},
+                  "members": [{{ .Values.hazelcast.members }}]
+                }
+              }
+            }
+            {{- end }}
+            {{- if and .Values.hazelcast.enabled .Values.redis.enabled }},{{ end }}
+            {{- if .Values.redis.enabled }}
+            "redis": {
+              "sentinel": {
+                "master": "{{ .Values.redis.sentinel.master }}",
+                "node": ["{{ .Values.redis.sentinel.hosts }}"]
+              },
+              "database": {{ .Values.redis.database }},
+              "timeout": "{{ .Values.redis.timeout }}",
+              "connect-timeout": "{{ .Values.redis.connectTimeout }}",
+              "pool": {
+                "enabled": true,
+                "max-active": {{ .Values.redis.pool.maxActive }},
+                "max-idle": {{ .Values.redis.pool.maxIdle }},
+                "min-idle": {{ .Values.redis.pool.minIdle }}
+              }
+            }
+            {{- end }}
+          }
+        },
+        "monitor": {
+          "endpoints": {
+            "endpoint": {
+              "defaults": {
+                "access": "PERMIT"
+              },
+              "health": {
+                "access": "PERMIT",
+                "group": {
+                  "cluster": {
+                    "include": "clusterHealthIndicator"
+                  }
+                }
+              }
+            }
+          }
+        }
+      },
+      "management": {
+        "endpoint": {
+          "health": {
+            "show-details": "always",
+            "group": {
+              "cluster": {
+                "include": "clusterHealthIndicator"
+              }
+            }
+          }
+        },
+        "endpoints": {
+          "web": {
+            "exposure": {
+              "include": "health,info,prometheus,cluster"
+            }
+          }
+        }
+      }
+    }
diff --git a/helm/cas/templates/deployment.yaml b/helm/cas/templates/deployment.yaml
new file mode 100644
index 00000000000..26dc42b650b
--- /dev/null
+++ b/helm/cas/templates/deployment.yaml
@@ -0,0 +1,71 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: {{ include "cas.fullname" . }}
+  labels:
+    {{- include "cas.labels" . | nindent 4 }}
+spec:
+  replicas: {{ .Values.replicaCount }}
+  selector:
+    matchLabels:
+      {{- include "cas.selectorLabels" . | nindent 6 }}
+  template:
+    metadata:
+      labels:
+        {{- include "cas.selectorLabels" . | nindent 8 }}
+      annotations:
+        checksum/config: {{ include (print $.Template.BasePath "/configmap.yaml") . | sha256sum }}
+    spec:
+      {{- if .Values.serviceAccount.create }}
+      serviceAccountName: {{ .Values.serviceAccount.name | default (include "cas.fullname" .) }}
+      {{- end }}
+      {{- with .Values.image.pullSecrets }}
+      imagePullSecrets:
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
+      containers:
+        - name: {{ .Chart.Name }}
+          image: "{{ .Values.image.repository }}:{{ .Values.image.tag | default .Chart.AppVersion }}"
+          imagePullPolicy: {{ .Values.image.pullPolicy }}
+          env:
+            - name: JAVA_OPTS
+              value: "{{ .Values.cas.javaOpts }}"
+            - name: SERVER_PORT
+              value: "{{ .Values.cas.serverPort }}"
+          ports:
+            - name: https
+              containerPort: {{ .Values.cas.serverPort }}
+              protocol: TCP
+            - name: http
+              containerPort: {{ .Values.cas.httpPort }}
+              protocol: TCP
+            {{- if .Values.hazelcast.enabled }}
+            - name: hazelcast
+              containerPort: {{ .Values.hazelcast.port }}
+              protocol: TCP
+            {{- end }}
+          livenessProbe:
+            {{- toYaml .Values.livenessProbe | nindent 12 }}
+          readinessProbe:
+            {{- toYaml .Values.readinessProbe | nindent 12 }}
+          resources:
+            {{- toYaml .Values.resources | nindent 12 }}
+          volumeMounts:
+            - name: cas-config
+              mountPath: /etc/cas/config
+      volumes:
+        - name: cas-config
+          configMap:
+            name: {{ include "cas.fullname" . }}-config
+      {{- with .Values.nodeSelector }}
+      nodeSelector:
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
+      {{- with .Values.affinity }}
+      affinity:
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
+      {{- with .Values.tolerations }}
+      tolerations:
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
diff --git a/helm/cas/templates/ingress.yaml b/helm/cas/templates/ingress.yaml
new file mode 100644
index 00000000000..f1459e2bd49
--- /dev/null
+++ b/helm/cas/templates/ingress.yaml
@@ -0,0 +1,35 @@
+{{- if .Values.ingress.enabled -}}
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: {{ include "cas.fullname" . }}
+  labels:
+    {{- include "cas.labels" . | nindent 4 }}
+  {{- with .Values.ingress.annotations }}
+  annotations:
+    {{- toYaml . | nindent 4 }}
+  {{- end }}
+spec:
+  {{- if .Values.ingress.className }}
+  ingressClassName: {{ .Values.ingress.className }}
+  {{- end }}
+  {{- if .Values.ingress.tls }}
+  tls:
+    {{- toYaml .Values.ingress.tls | nindent 4 }}
+  {{- end }}
+  rules:
+    {{- range .Values.ingress.hosts }}
+    - host: {{ .host | quote }}
+      http:
+        paths:
+          {{- range .paths }}
+          - path: {{ .path }}
+            pathType: {{ .pathType }}
+            backend:
+              service:
+                name: {{ include "cas.fullname" $ }}
+                port:
+                  number: {{ .port }}
+          {{- end }}
+    {{- end }}
+{{- end }}
